---
/**
 * Botones para difundir una nota.
 *
 * X, LinkedIn, Facebook y WhatsApp son enlaces construidos en tiempo de
 * compilación: funcionan sin JavaScript. Instagram y «copiar enlace» sí lo
 * requieren, porque Instagram no expone una URL de compartir web.
 */
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;

const e = encodeURIComponent;
const links = [
  {
    key: 'x',
    label: 'Compartir en X',
    href: `https://twitter.com/intent/tweet?text=${e(title)}&url=${e(url)}`,
    path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    key: 'linkedin',
    label: 'Compartir en LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${e(url)}`,
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z',
  },
  {
    key: 'facebook',
    label: 'Compartir en Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${e(url)}`,
    path: 'M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z',
  },
  {
    key: 'whatsapp',
    label: 'Compartir por WhatsApp',
    href: `https://wa.me/?text=${e(`${title} ${url}`)}`,
    path: 'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35zM12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.64-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.82 9.82 0 0 1 6.99 2.9 9.82 9.82 0 0 1 2.9 6.99c0 5.45-4.44 9.87-9.9 9.87zM20.5 3.49A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.33.16 11.89c0 2.09.55 4.14 1.59 5.94L.06 24l6.31-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.33 11.89-11.89 0-3.18-1.24-6.16-3.49-8.41z',
  },
];

const instagramPath =
  'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.31-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z';
---

<div class="share-bar" data-share-bar data-share-url={url} data-share-title={title}>
  <span class="share-bar__label">Compartir</span>
  <div class="share-bar__buttons">
    {links.map((link) => (
      <a
        class="share-bar__item"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
        title={link.label}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={link.path} /></svg>
      </a>
    ))}
    <button class="share-bar__item" type="button" data-share-instagram aria-label="Compartir en Instagram" title="Compartir en Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={instagramPath} /></svg>
    </button>
    <button class="share-bar__item share-bar__item--copy" type="button" data-share-copy aria-label="Copiar enlace de la nota" title="Copiar enlace">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.5 13.5a4.5 4.5 0 0 0 6.36 0l3-3a4.5 4.5 0 0 0-6.36-6.36l-1.5 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14.5 10.5a4.5 4.5 0 0 0-6.36 0l-3 3a4.5 4.5 0 0 0 6.36 6.36l1.5-1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span>Copiar enlace</span>
    </button>
  </div>
  <p class="share-bar__status" data-share-status role="status" aria-live="polite"></p>
</div>

<style>
  .share-bar { display: flex; flex-wrap: wrap; gap: .6rem 1rem; align-items: center; }
  .share-bar__label { color: var(--muted); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .share-bar__buttons { display: flex; flex-wrap: wrap; gap: .45rem; align-items: center; }
  .share-bar__item {
    display: inline-grid; width: 2.35rem; height: 2.35rem; place-items: center;
    padding: 0; border: 1px solid var(--line); border-radius: 999px;
    color: var(--navy-800); background: var(--paper); cursor: pointer;
    text-decoration: none;
    transition: transform 200ms var(--ease-out), border-color 200ms ease, color 200ms ease, background 200ms ease;
  }
  .share-bar__item svg { width: 1rem; height: 1rem; fill: currentColor; }
  .share-bar__item:hover { transform: translateY(-2px); border-color: var(--navy-800); color: var(--paper); background: var(--navy-800); }
  .share-bar__item--copy { width: auto; padding-inline: .85rem; gap: .45rem; grid-auto-flow: column; }
  .share-bar__item--copy span { font-size: .74rem; font-weight: 700; }
  .share-bar__item--copy svg { fill: none; }
  .share-bar__status { margin: 0; color: var(--rain-700); font-size: .74rem; font-weight: 700; }
  .share-bar__status:empty { display: none; }
  @media (prefers-reduced-motion: reduce) { .share-bar__item:hover { transform: none; } }
  @media (max-width: 420px) { .share-bar__item--copy span { display: none; } .share-bar__item--copy { width: 2.35rem; padding-inline: 0; } }
</style>

<script>
  const copyToClipboard = async (text: string) => {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return;
      } catch {
        // La API puede rechazar por permisos o por falta de gesto del usuario;
        // en ese caso todavía queda el respaldo de abajo.
      }
    }
    // Respaldo para contextos no seguros (http) y para navegadores que niegan
    // el acceso al portapapeles.
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.appendChild(field);
    field.select();
    document.execCommand('copy');
    document.body.removeChild(field);
  };

  const initShareBars = () => {
    document.querySelectorAll<HTMLElement>('[data-share-bar]:not([data-share-ready])').forEach((bar) => {
      bar.dataset.shareReady = 'true';

      const url = bar.dataset.shareUrl ?? window.location.href;
      const title = bar.dataset.shareTitle ?? document.title;
      const status = bar.querySelector<HTMLElement>('[data-share-status]');

      let timer: number | undefined;
      const announce = (message: string) => {
        if (!status) return;
        status.textContent = message;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => { status.textContent = ''; }, 3000);
      };

      bar.querySelector<HTMLButtonElement>('[data-share-copy]')?.addEventListener('click', async () => {
        try {
          await copyToClipboard(url);
          announce('¡Enlace copiado!');
        } catch {
          announce('No se pudo copiar. Copie la dirección desde la barra del navegador.');
        }
      });

      // Instagram no tiene URL de compartir web. En móvil se delega al menú
      // nativo del sistema (que sí lista Instagram); en escritorio se copia el
      // enlace y se abre Instagram para que la persona lo pegue.
      bar.querySelector<HTMLButtonElement>('[data-share-instagram]')?.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch (error) {
            if ((error as DOMException)?.name === 'AbortError') return;
          }
        }
        try {
          await copyToClipboard(url);
          announce('Enlace copiado: péguelo en su publicación o historia de Instagram.');
        } catch {
          announce('Copie la dirección desde la barra del navegador para pegarla en Instagram.');
        }
        window.open('https://www.instagram.com/', '_blank', 'noopener');
      });
    });
  };

  document.addEventListener('astro:page-load', initShareBars);
  initShareBars();
</script>
